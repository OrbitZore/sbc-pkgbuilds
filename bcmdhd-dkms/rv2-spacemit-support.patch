+#endif /* CONFIG_BCMDHD_SPACEMIT */
 #ifdef CUSTOMER_HW_PLATFORM
 		err = sdhci_force_presence_change(&sdmmc_channel, 1);
 #endif /* CUSTOMER_HW_PLATFORM */
@@ -132,6 +235,10 @@ dhd_wlan_set_carddetect(int present)
 	} else {
 #if defined(BCMSDIO)
 		printf("======== Card detection to remove SDIO card! ========\n");
+#ifdef CONFIG_BCMDHD_SPACEMIT
+		if (spacemit_sdio_detect_change)
+			spacemit_sdio_detect_change(0);
+#endif /* CONFIG_BCMDHD_SPACEMIT */
 #ifdef CUSTOMER_HW_PLATFORM
 		err = sdhci_force_presence_change(&sdmmc_channel, 0);
 #endif /* CUSTOMER_HW_PLATFORM */
@@ -268,6 +375,7 @@ dhd_wlan_init_gpio(wifi_adapter_info_t *adapter)
 	/* Please check your schematic and fill right GPIO number which connected to
 	* WL_REG_ON and WL_HOST_WAKE.
 	*/
+	dhd_spacemit_setup();
 #ifdef BCMDHD_DTS
 #ifdef BCMDHD_PLATDEV
 	if (adapter->pdev) {
@@ -356,6 +464,13 @@ dhd_wlan_init_gpio(wifi_adapter_info_t *adapter)
 #endif
 	host_oob_irq_flags &= IRQF_TRIGGER_MASK;
 
+#ifdef CONFIG_BCMDHD_SPACEMIT
+	/* SDIO in-band interrupts are used on this platform (see Makefile);
